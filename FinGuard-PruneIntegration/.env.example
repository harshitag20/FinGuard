# ==============================================================================
# FinGuard-PruneIntegration Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real API keys or sensitive values to version control.
# - The actual Gemini LLM provider key is vaulted directly in Prune (AES-256-GCM).
# - PRUNE_ENABLED defaults to false. The gateway will not intercept traffic unless set to true.
# ==============================================================================

# Prune Gateway API Key (starts with prune_...)
# Generated from https://app.withprune.com -> Connect -> API Keys
PRUNE_API_KEY=prune_your_prune_api_key_here

# Base URL for Prune Gateway OpenAI-compatible endpoint
PRUNE_BASE_URL=https://api.withprune.com/v1

# Master kill-switch. When false, the gateway integration is disabled.
PRUNE_ENABLED=false

# Operating mode:
# - "shadow": Execute requests through Prune but allow safe observability logging
# - "active": Full enforcement mode
PRUNE_MODE=shadow

# Default FinGuard feature attribution
# Allowed values: disease_screening | general_chat | farm_agent | research_assistant | report_summarization | voice_expert_text
PRUNE_DEFAULT_FEATURE_ID=general_chat

# Default FinGuard workload attribution
# Allowed values: finGuard_core | finGuard_farm_agent | finGuard_voice_expert
PRUNE_DEFAULT_WORKLOAD=finGuard_core

# Request timeout in seconds for gateway calls
PRUNE_TIMEOUT_SECONDS=30

# Maximum number of retries for transient gateway errors (network / 5xx)
PRUNE_MAX_RETRIES=1

# Gateway caching policy:
# - "disabled" / "off": Caching disabled (default & required for farm diagnostic & sensitive data)
# - "exact": Exact prompt match caching (only for approved static/educational queries)
# - "semantic": Semantic similarity caching (STRICTLY PROHIBITED for farm/diagnostic data)
PRUNE_CACHE_POLICY=disabled

# Emergency direct provider fallback toggle:
# When true, falls back to direct Gemini provider ONLY if explicitly configured.
# WARNING: Direct fallback bypasses Prune Shield and spending controls. Defaults strictly to false.
PRUNE_ALLOW_DIRECT_FALLBACK=false

# Target Gemini model (e.g., gemini-2.5-flash)
# Note: Upstream Gemini v1beta deprecated gemini-1.5-flash and gemini-2.0-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional: Live integration test toggle (requires valid PRUNE_API_KEY and vaulted Gemini key)
ENABLE_LIVE_PRUNE_TESTS=false

