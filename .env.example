# FinGuard.io Global Environment Template

# Core Backend Microservice
PORT=3001
NODE_ENV=development
DATABASE_DIR=./src/data

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# FinGuard-FarmAgent Service (Maritime Agent Infrastructure)
FARMAGENT_BASE_URL=http://localhost:8080
FARMAGENT_SERVICE_KEY=finguard-internal-secret-key-2026

# FinGuard-PruneIntegration (Prune Model Routing Gateway)
PRUNE_API_KEY=your_prune_api_key_here
PRUNE_BASE_URL=https://api.withprune.com/v1
PRUNE_ENABLED=false
PRUNE_MODEL=gemini-2.5-flash
PRUNE_ALLOW_DIRECT_FALLBACK=true

# Frontend Client
VITE_API_URL=http://localhost:3001
